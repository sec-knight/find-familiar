# Find Familiar runner worker — non-secret configuration.
# FAMILIAR_RUNNER_TOKEN lives in /srv/familiar/secrets/familiar.secrets.env.

FAMILIAR_WORKER_CONFIG=/srv/familiar/config/worker.json

# The native Claude executable. The Runner supplies the adapter's worktree,
# allowed root and mode per invocation, but NOT this — it is inherited from the
# worker's own environment, and a worker started without it claims sessions
# normally and then fails every one of them at adapter configuration.
FAMILIAR_CLAUDE_RUNTIME_PATH=/ABSOLUTE/PATH/TO/claude
