# Find Familiar server — non-secret configuration.
# Secrets live in /srv/familiar/secrets/familiar.secrets.env (mode 0600) and are
# loaded separately, so this file is safe to read, copy and version.

ASPNETCORE_ENVIRONMENT=Development

# Loopback for local tooling, plus the Tailscale address for remote access.
# Deliberately NOT 0.0.0.0 — this application has no authentication of its own,
# so reachability is limited to an already-authenticated network.
ASPNETCORE_URLS=http://127.0.0.1:5199;http://YOUR-TAILSCALE-IP:5199

# Reasoning provider. "OpenAiCompatible" covers local runtimes and hosted
# endpoints alike; unset this line entirely to fall back to the honest default,
# which needs no credential and still renders the page.
Familiar__Reasoning__Provider=OpenAiCompatible
Familiar__Reasoning__OpenAiCompatible__BaseAddress=https://openrouter.ai/api/v1
Familiar__Reasoning__OpenAiCompatible__Model=nvidia/nemotron-3-super-120b-a12b:free
Familiar__Reasoning__OpenAiCompatible__DisplayName=OpenRouter (nemotron-3-super-120b)

# The NAME of the environment variable holding the key — never the key itself.
Familiar__Reasoning__OpenAiCompatible__ApiKeyVariable=OPENROUTER_API_KEY

# Retrieval relevance floor (ADR-0015). Where the bar sits between answering the
# question and merely sharing a word with it. Below the bar the search reports an
# explicit no-match instead of narrating its best near-miss.
Familiar__Retrieval__MinimumScore=4
Familiar__Retrieval__MinimumMatchedTerms=2

# Automated repository state snapshot (ADR-0015). Off unless a path is set: this
# is the one part of the talk lane that runs a process on the host.
#
# The timer is the backstop. deploy/git-hooks/post-commit is what makes a snapshot
# current within seconds of a commit, and nothing depends on it being installed.
Familiar__RepositorySnapshot__Enabled=true
Familiar__RepositorySnapshot__RepositoryPath=/srv/familiar/apps/FindFamiliar
Familiar__RepositorySnapshot__IntervalMinutes=30

# Optional. With exactly one non-sensitive active project this is inferred; set it
# once there is more than one, or nothing is written.
# Familiar__RepositorySnapshot__ProjectId=2f098ffc-b981-4b1a-b47d-f3a6b93e1771

# ---- The Summoning Gate (ADR-0016) ----
#
# Who this Familiar is, to an external client about to speak as it. Guidance is a
# note on register and not a system prompt; it is capped at 500 characters so it
# cannot quietly become one.
Familiar__Identity__Name=Sakura
Familiar__Identity__Guidance=Speak plainly and briefly. Say what the records show and when they end.

# Whether an external AI client may reach this Familiar at all. With this false no
# gateway route is mapped, so a probe gets 404 rather than a 401 confirming there
# is something here worth guessing at.
#
# The TOKEN lives in the secrets file, never here:
#   FamiliarGateway__Enabled=true
#   FamiliarGateway__Token=<openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'>
#
# It is a SEPARATE credential from FAMILIAR_RUNNER_TOKEN on purpose. The runner
# token stays on this machine and the tailnet; this one is held by a frontier
# vendor and crosses the public internet on every call. Sharing one would mean a
# leak at either end gives away both.
#
# Read-only in every direction: see docs/familiar-gateway-setup.md, and read §5
# there before changing any networking to make /mcp publicly reachable.
FamiliarGateway__Enabled=false
