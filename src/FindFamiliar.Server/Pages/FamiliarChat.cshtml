@page "/Familiar/Chat/{chatId:guid}"
@using FindFamiliar.Server.Domain
@model FindFamiliar.Server.Pages.FamiliarChatModel
@{
    ViewData["Title"] = Model.Chat is null ? "Familiar" : $"Familiar — {Model.Chat.Title}";
}

@section Head {
    @* The no-script fallback, and only while a reply is actually arriving. familiar-chat.js removes
       this tag as soon as it runs, because a refresh would tear down a stream mid-sentence. A browser
       with scripting disabled keeps it and still sees the reply arrive, just in whole-page steps. *@
    @if (Model.HasTurnInFlight)
    {
        <meta http-equiv="refresh" content="@FindFamiliar.Server.Pages.FamiliarChatModel.InFlightRefreshSeconds" />
    }
}

@section Scripts {
    <script src="~/js/familiar-chat.js" asp-append-version="true"></script>
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <p role="status" class="demiplane-flash">@statusMessage</p>
}

@if (Model.Chat is not { } chat)
{
    <section class="dashboard-intro" aria-labelledby="familiar-chat-title">
        <p class="eyebrow">Familiar</p>
        <h1 id="familiar-chat-title">This conversation could not be read</h1>
    </section>
}
else
{
    <section class="dashboard-intro" aria-labelledby="familiar-chat-title">
        <p class="eyebrow">Familiar</p>
        <h1 id="familiar-chat-title">@chat.Title</h1>
        <p>
            <a asp-page="/FamiliarChats">All conversations</a>
            @if (chat.FocusProjectId is { } focusProjectId)
            {
                <span> · focus <a asp-page="/Demiplane" asp-route-id="@focusProjectId">@chat.FocusProjectName</a></span>
            }
            else
            {
                <span> · no project focus — this conversation can see everything</span>
            }
        </p>
    </section>

    @* ----------------------------------------------------------------------------- Transcript *@
    @* data-cursor is the client's whole durable state: the sequence it has rendered through. Every
       reconnection, wake-up and network handoff resumes from it, so a device four hours behind takes
       the same path as one four seconds behind. *@
    <section class="familiar-conversation" aria-labelledby="transcript-title"
             data-familiar-chat data-chat-id="@chat.ChatId" data-cursor="@Model.ResumeCursor">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Conversation · through sequence @Model.Cursor</p>
                <h2 id="transcript-title">What has been asked</h2>
            </div>
        </div>

        @* Written only by the script, and only when the connection is not healthy. Silence means
           connected: a permanent "live" badge would be a claim the page cannot keep. *@
        <p role="status" class="familiar-note" data-stream-status hidden></p>

        @if (chat.Turns.Count == 0)
        {
            <p>Nothing asked yet.</p>
        }
        else
        {
            @* Oldest first, in Sequence order as the service returned them — never by timestamp,
               which cannot order two turns written in the same tick. *@
            @* One list item per exchange, keyed by sequence, so the script updates a turn in place
               rather than rebuilding a transcript somebody is reading. The server-rendered markup and
               the script-built markup are the same shape on purpose: the page must look identical
               whether it arrived by render or by stream. *@
            <ol class="familiar-messages" data-transcript>
                @foreach (var turn in chat.Turns)
                {
                    <li class="familiar-turn" data-turn-sequence="@turn.Sequence">
                        <div class="familiar-message is-human">
                            <p class="familiar-message-meta">
                                <span class="familiar-message-author">You</span>
                                <span> · <time datetime="@turn.CreatedUtc.ToString("O")">@turn.CreatedUtc.ToString("dd MMM yyyy, HH:mm") UTC</time></span>
                            </p>

                            @* Encoded by Razor, and nothing here interprets it: no Html.Raw, no
                               markdown rendering, no autolinking. The script uses textContent for the
                               same reason. Line breaks come from CSS white-space: pre-wrap. *@
                            <p class="conversation-block" data-user-text>@turn.UserText</p>
                        </div>

                        <div class="familiar-message @FindFamiliar.Server.Pages.FamiliarChatModel.StateCss(turn.State)" data-reply>
                            <p class="familiar-message-meta">
                                <span class="familiar-message-author" data-reply-author>@FindFamiliar.Server.Pages.FamiliarChatModel.StateLabel(turn.State)</span>
                                <span data-failed hidden="@(turn.State != FamiliarChatTurnState.Failed)"> · <strong>Failed</strong></span>
                                @if (turn.ProviderName is { Length: > 0 } providerName)
                                {
                                    <span> · @providerName</span>
                                    @if (turn.ProviderModel is { Length: > 0 } providerModel)
                                    {
                                        <span> (@providerModel)</span>
                                    }
                                }
                            </p>

                            @* Segmented rather than printed whole, so a cited id becomes a chip. Every
                               piece is still written as text by Razor — no Html.Raw anywhere — and the
                               script builds the same shape with textContent for the same reason. *@
                            <p class="conversation-block" data-output hidden="@(turn.Output.Length == 0)">@foreach (var segment in turn.Segments)
                                {
                                    if (!segment.IsCitation)
                                    {
                                        @segment.Text
                                    }
                                    else if (turn.Cited.FirstOrDefault(citation => citation.EntryId == segment.EntryId) is { } cited)
                                    {
                                        <a class="familiar-citation" asp-page="/Demiplane" asp-route-id="@cited.ProjectId"
                                           title="@cited.Kind — @cited.Title">@cited.Kind.ToString().ToLowerInvariant(): @cited.Title</a>
                                    }
                                    else
                                    {
                                        @* Named, never silently deleted. A reply citing something it was
                                           never shown is the most diagnostic thing it can do, and a
                                           reader is entitled to see it happen. *@
                                        <span class="familiar-citation is-unsupported"
                                              title="This reference was not among the entries this answer was given.">unsupported reference</span>
                                    }
                                }</p>

                            @* The plan, in the transcript at the point it was proposed. Slice 3 renders
                               it and nothing more: there is no approve control yet, and nothing in the
                               system can act on it. *@
                            @if (turn.Plan is { } plan)
                            {
                                <section class="familiar-plan" data-plan aria-label="Drafted plan">
                                    <p class="familiar-plan-meta">
                                        <strong>Drafted plan</strong>
                                        <span> · @plan.ProjectName</span>
                                        <span> · @plan.Status.ToString().ToLowerInvariant()</span>
                                    </p>

                                    <p class="familiar-plan-summary">@plan.Summary</p>

                                    <ol class="familiar-plan-items">
                                        @foreach (var item in plan.Items)
                                        {
                                            <li class="familiar-plan-item">
                                                <p class="familiar-plan-item-title">@item.Title</p>
                                                <p class="familiar-plan-item-outcome">@item.RequestedOutcome</p>
                                                <p class="familiar-plan-item-meta">
                                                    @if (item.Role is { } role)
                                                    {
                                                        <span class="familiar-plan-role">starts a @role session</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="familiar-plan-role is-quiet">records the work, starts nothing</span>
                                                    }

                                                    @foreach (var evidence in item.Evidence)
                                                    {
                                                        <a class="familiar-citation" asp-page="/Demiplane" asp-route-id="@evidence.ProjectId"
                                                           title="@evidence.Kind — @evidence.Title">@evidence.Kind.ToString().ToLowerInvariant(): @evidence.Title</a>
                                                    }
                                                </p>
                                            </li>
                                        }
                                    </ol>

                                    @* Stated before there is anything to press. The disclosure is what makes
                                       an approval an act of reading rather than of trust, so it is written
                                       and tested now rather than added beside the button later. *@
                                    <p class="familiar-plan-consequence">
                                        Approving this would create @plan.Included.Count task(s) in @plan.ProjectName@(plan.FirstSessionItem is { } first
                                            ? $" and start one {first.Role} session, on “{first.Title}”." : " and start no sessions.")
                                        Nothing has been created yet.
                                    </p>

                                    <p class="familiar-plan-note">
                                        Approving a plan in the conversation is not built yet. This is a record of what was
                                        proposed.
                                    </p>
                                </section>
                            }

                            <p role="status" data-pending hidden="@(!(turn.IsInFlight && turn.Output.Length == 0))">
                                Working on this. It is being generated on the server, so you can close
                                this page — the reply will be here when you come back.
                            </p>
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    @* --------------------------------------------------------------------------------- Input *@
    <section class="familiar-compose" aria-labelledby="compose-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Ask</p>
                <h2 id="compose-title">Say something</h2>
            </div>
        </div>

        <form method="post" asp-page-handler="Send" asp-route-chatId="@chat.ChatId">
            <label class="familiar-compose-label" for="familiar-chat-message">Your message</label>

            @if (Model.SendValidationMessage is { } validationMessage)
            {
                <p class="familiar-compose-error" role="alert" id="familiar-chat-message-error">@validationMessage</p>
            }

            @* Not disabled while a reply is in flight. The server refuses a second turn and says so,
               and a disabled control is a hint to a browser rather than a rule — the rule is the
               filtered unique index on the turn table. *@
            <textarea id="familiar-chat-message" name="Message" class="familiar-compose-input" rows="3"
                      maxlength="@FamiliarChatTurn.MaxUserTextLength"
                      placeholder="Ask about anything that is recorded…"
                      aria-describedby="familiar-chat-message-hint@(Model.SendValidationMessage is null ? "" : " familiar-chat-message-error")"
                      required>@Model.Message</textarea>

            <p class="familiar-compose-hint" id="familiar-chat-message-hint">
                Up to @FamiliarChatTurn.MaxUserTextLength.ToString("N0") characters.
                One reply at a time — the Familiar answers from what is recorded, and cannot change anything.
            </p>

            @* Two buttons, one form. "Plan this" is a different request, not a different page: the
               conversation stays the control surface, and the person declares which they want rather
               than the server guessing it from their words. *@
            <div class="familiar-compose-actions">
                <button type="submit" class="familiar-compose-send" name="RequestPlan" value="false">Send</button>
                <button type="submit" class="familiar-compose-plan" name="RequestPlan" value="true">Plan this</button>
            </div>
        </form>
    </section>
}
