<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Find Familiar</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Head contributions from a page, e.g. the Demiplane's conditional refresh. Metadata belongs
       here rather than in the body, where it is non-conformant. *@
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="app-shell">
    <header class="site-header">
        <div class="site-frame site-header-content">
            <a class="brand" asp-area="" asp-page="/Index" aria-label="Find Familiar dashboard">
                <span class="brand-mark" aria-hidden="true">FF</span>
                <span>Find Familiar</span>
            </a>
            <nav class="site-nav" aria-label="Primary navigation">
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "is-active" : "")" asp-area="" asp-page="/Index">Dashboard</a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Talk", StringComparison.Ordinal) == true ? "is-active" : "")" asp-area="" asp-page="/Talk/Index">Talk</a>
@* A Demiplane is always a specific project's, so it has no bare nav entry; it keeps Projects lit. *@
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() is "/Projects/Index" or "/Demiplane" ? "is-active" : "")" asp-area="" asp-page="/Projects/Index">Projects</a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Work" ? "is-active" : "")" asp-area="" asp-page="/Work">Work queue</a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Workers" ? "is-active" : "")" asp-area="" asp-page="/Workers">Workers</a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/About" ? "is-active" : "")" asp-area="" asp-page="/About">About</a>
            </nav>
        </div>
    </header>
    <main class="site-frame site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-frame">
            &copy; 2026 Find Familiar
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
